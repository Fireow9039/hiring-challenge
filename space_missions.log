awk -F'|' '
  /^[[:space:]]*#/ { next }
  NF >= 8 {
    for (i=1; i<=NF; i++) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
    }

    destination = $3
    status = $4
    duration = $6
    code = $8

    if (destination == "Mars" && status == "Completed" && duration + 0 > max) {
      max = duration + 0
      security_code = code
    }
  }
  END {
    print security_code
  }
' space_missions.log
